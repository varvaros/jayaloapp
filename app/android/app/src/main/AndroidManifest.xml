<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Onboarding: GPS para proponer ubicación (spec §6.3/§7.3). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <application
        android:label="Jayalo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="false"><!--
        Predictive back (OnBackInvokedCallback) DESACTIVADO a propósito
        (bug PO 2026-07-23: "el atrás del chat minimiza la app"). Con targetSdk
        36 Android lo activa por defecto; en ese modo el chat (ruta TOP-LEVEL
        apilada sobre el shell) minimiza en vez de volver — el predictive-back
        no respeta el PopScope de un route directo del navigator raíz (solo el
        de los navigators anidados, por eso las rutas del shell sí funcionaban).
        En el camino legacy, Activity.onBackPressed → framework → PopScope
        (BackGuard) se dispara SIEMPRE y navega bien en todas las rutas. Se
        pierde solo la animación de "peek" del predictive-back (cosmético). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link de retorno tras recargar por PayPal en la web
                 (jayalo://wallet). El pago sigue en la web; esto solo trae la
                 app al frente y refresca el saldo. singleTop reutiliza la
                 instancia viva (no crea otra). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="jayalo" android:host="wallet"/>
            </intent-filter>
        </activity>
        <!-- Canal por defecto de FCM. DEBE coincidir con MainActivity.
             ALERTS_CHANNEL_ID: si apunta a un canal que la app no crea, FCM cae
             a su canal de reserva y el sonido custom NO suena (fue justo lo que
             pasó entre f16199d y 2026-07-28: aquí decía "jayalo_alerts" y
             MainActivity ya creaba "jayalo_alerts_v2").
             Los mensajes de chat NO usan este canal: send-push les pide
             "jayalo_chat_v1" explícitamente. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jayalo_alerts_v2" />

        <!-- Ícono PEQUEÑO de la barra de estado. Sin esto FCM cae al ícono del
             launcher, que es a todo color y opaco; como Android >= 21 usa SOLO
             el canal alfa del ícono pequeño, se veía un CUADRADO NEGRO (reporte
             PO 2026-07-28). ic_stat_jayalo es la silueta blanca de la mascota. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_jayalo" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- image_cropper (UCrop): pantalla de recorte de la foto al solicitar. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Jayalo.UCrop" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
