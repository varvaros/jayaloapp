<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Onboarding: GPS para proponer ubicación (spec §6.3/§7.3). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <application
        android:label="Jayalo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="false"><!--
        allowBackup=false a propósito (auditoría 2026-07-30): sin declararlo,
        el default de Android es TRUE y Auto Backup sube shared_prefs/ al Drive
        del usuario — y ahí es donde supabase_flutter persiste el REFRESH TOKEN
        en claro. Con backup activo el token salía del dispositivo, se
        restauraba al cambiar de teléfono y sobrevivía fuera del alcance del
        cierre de sesión; en Android <=11 con depuración USB, `adb backup` lo
        extraía directamente. Ningún dato de la app merece respaldarse: todo
        vive en Supabase y se recupera al iniciar sesión.
        `dataExtractionRules` cubre Android 12+ (backup en la nube y
        transferencia directa entre dispositivos); `fullBackupContent` cubre
        Android 11 y anteriores. --><!--
        Predictive back (OnBackInvokedCallback) DESACTIVADO a propósito
        (bug PO 2026-07-23: "el atrás del chat minimiza la app"). Con targetSdk
        36 Android lo activa por defecto; en ese modo el chat (ruta TOP-LEVEL
        apilada sobre el shell) minimiza en vez de volver — el predictive-back
        no respeta el PopScope de un route directo del navigator raíz (solo el
        de los navigators anidados, por eso las rutas del shell sí funcionaban).
        En el camino legacy, Activity.onBackPressed → framework → PopScope
        (BackGuard) se dispara SIEMPRE y navega bien en todas las rutas. Se
        pierde solo la animación de "peek" del predictive-back (cosmético). --><!--
        networkSecurityConfig (hallazgo de Aikido 2026-08-19): con targetSdk 36
        y minSdk 24 Android YA prohíbe el tráfico en claro y YA desconfía de las
        CAs que instala el usuario. El fichero no cambia nada: congela esa
        postura para que no la abra por accidente un manifest fusionado de una
        dependencia. El porqué completo — y por qué NO hay pinning — vive en
        res/xml/network_security_config.xml. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link de retorno tras recargar por PayPal en la web
                 (jayalo://wallet). El pago sigue en la web; esto solo trae la
                 app al frente y refresca el saldo. singleTop reutiliza la
                 instancia viva (no crea otra).

                 Sobre `autoVerify`/assetlinks.json: NO aplican aquí. La
                 verificación de App Links solo existe para intent-filters
                 `http`/`https`; un esquema propio como `jayalo://` no es
                 verificable por diseño, así que otra app PUEDE registrar el
                 mismo esquema y aparecer en el selector. Es aceptable porque
                 este link no lleva ningún secreto: `_handleLink` (app.dart)
                 exige el host `wallet` y el saldo lo relee del backend, así que
                 lo peor que consigue un impostor es abrir su propia pantalla.
                 Si algún día esto pasa a `https://jayalo.com/...`, entonces sí
                 hará falta publicar `/.well-known/assetlinks.json` con el
                 SHA-256 de Play App Signing (que hoy no existe: no hay cuenta
                 de Play Console todavía). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="jayalo" android:host="wallet"/>
            </intent-filter>
        </activity>
        <!-- Canal por defecto de FCM. DEBE coincidir con MainActivity.
             ALERTS_CHANNEL_ID: si apunta a un canal que la app no crea, FCM cae
             a su canal de reserva y el sonido custom NO suena (fue justo lo que
             pasó entre f16199d y 2026-07-28: aquí decía "jayalo_alerts" y
             MainActivity ya creaba "jayalo_alerts_v2").
             Los mensajes de chat NO usan este canal: send-push les pide
             "jayalo_chat_v1" explícitamente. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jayalo_alerts_v2" />

        <!-- Ícono PEQUEÑO de la barra de estado. Sin esto FCM cae al ícono del
             launcher, que es a todo color y opaco; como Android >= 21 usa SOLO
             el canal alfa del ícono pequeño, se veía un CUADRADO NEGRO (reporte
             PO 2026-07-28). ic_stat_jayalo es la silueta blanca de la mascota. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_jayalo" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- image_cropper (UCrop): pantalla de recorte de la foto al solicitar. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Jayalo.UCrop" />

        <!-- Sello de build: de que rama y commit salio este binario. Lo
             rellena Gradle (ver `manifestPlaceholders` en build.gradle.kts) y
             lo lee Ajustes → «Esta version» a traves de un MethodChannel. -->
        <meta-data
            android:name="com.jayalo.app.BUILD_RAMA"
            android:value="${buildRama}" />
        <meta-data
            android:name="com.jayalo.app.BUILD_SHA"
            android:value="${buildSha}" />
        <meta-data
            android:name="com.jayalo.app.BUILD_SUCIO"
            android:value="${buildSucio}" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
